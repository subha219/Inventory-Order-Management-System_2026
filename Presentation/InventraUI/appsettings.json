{
  "ConnectionStrings": {
    // No password here. Provide a real value via user-secrets or the env var ConnectionStrings__DefaultConnection.
    "DefaultConnection": "Server=localhost;Database=WHMS;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=10;"
  },
  "DatabaseProvider": "SqlServer",
  "Database": {
    "UseMigrations": false, // set true once you have generated EF migrations
    "EnableSensitiveDataLogging": false
  },
  "FileImageManager": {
    "PathFolder": "wwwroot/app_data/images",
    "MaxFileSizeInMB": 5
  },
  "FileDocumentManager": {
    "PathFolder": "wwwroot/app_data/docs",
    "MaxFileSizeInMB": 25
  },
  "AspNetIdentity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 8
    },
    "Lockout": {
      "DefaultLockoutTimeSpanInMinutes": 30,
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": true //confirmation will sent through email, make sure SMTP Config is OK.
    },
    "DefaultAdmin": {
      "Email": "admin@root.com",
      // Set via user-secrets / env var AspNetIdentity__DefaultAdmin__Password. Must satisfy the password policy above.
      "Password": ""
    }
  },
  "Jwt": {
    // REQUIRED, minimum 32 chars. Set via user-secrets / env var Jwt__Key. Never commit a real key.
    "Key": "",
    "Issuer": "WHMS",
    "Audience": "WHMS-Users",
    "ExpireInMinute": 30,
    "ClockSkewInMinute": 0
  },
  "Cors": {
    // Front end is served by this same app, so none are needed. Add origins here only for external clients.
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 1200,
    "AuthPermitPerMinute": 10
  },
  "SmtpSettings": {
    "Host": "",
    "Port": 465,
    "UserName": "",
    "Password": "", // use env var SmtpSettings__Password
    "FromAddress": "",
    "FromName": "Inventra"
  },
  "LowStockAlerts": {
    // Daily email listing products at or below their reorder point. Needs SmtpSettings above to be filled in.
    "Enabled": false,
    "Recipients": [], // e.g. [ "purchasing@yourcompany.com" ]
    "SendAtHourUtc": 3 // 3 = about 08:30 India time
  },
  "Reports": {
    // Minutes east of UTC that scheduled report times are written in. 330 = India (UTC+05:30).
    "TimeZoneOffsetMinutes": 330
  },
  "Approvals": {
    // Stock adjustments and scrapping that move at least UnitsThreshold units must be approved before they are confirmed.
    "Enabled": true,
    "UnitsThreshold": 100,
    "ApproverRoles": [ "Users" ] // people in these roles confirm directly and can approve or reject requests
  },
  "IsDemoVersion": false,
  "CreateDemoLogins": true, // set to false for a real client: no *.test@example.com demo users are created
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5249"
      }
    }
  },
  "AllowedHosts": "*"
}
