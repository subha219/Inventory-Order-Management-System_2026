@page
@attribute [Authorize(Roles = "Products")]
@{
    ViewData["Title"] = "Import Data";
}

<div id="app" v-cloak>
    <div class="an-card" style="margin:1rem 1.5rem">
        <div class="an-head">
            <h6><i class="fas fa-file-import me-2" style="color:var(--primary)"></i>Import data <small>bring products, opening stock, vendors and customers in from a CSV file</small></h6>
            <div class="ap-tabs">
                <button v-for="t in state.tabs" :key="t.key" type="button" class="ap-tab" :class="{ on: state.tab === t.key }" @@click="handler.setTab(t.key)">{{ t.label }}</button>
            </div>
        </div>

        <div class="im-help">
            <div v-if="state.tab === 'products'">
                <b>Products.</b> Columns: <code>Name</code> (required), <code>Description</code>, <code>UnitPrice</code>, <code>ReorderPoint</code>, <code>ReorderQuantity</code>, <code>ProductGroup</code>, <code>UnitMeasure</code>, <code>Physical</code> (yes/no).
                Product numbers are generated for you. A product whose name already exists is skipped. An unknown group or unit is created.
            </div>
            <div v-else-if="state.tab === 'vendors' || state.tab === 'customers'">
                <b>{{ state.tab === 'vendors' ? 'Vendors' : 'Customers' }}.</b> Columns: <code>Name</code> (required), <code>Description</code>, <code>Street</code>, <code>City</code>, <code>State</code>, <code>ZipCode</code>, <code>Country</code>, <code>PhoneNumber</code>, <code>EmailAddress</code>, <code>Website</code>, <code>Group</code>, <code>Category</code>.
                Numbers are generated for you. A row whose name or e-mail address already exists is skipped. An unknown group or category is created; if you leave them empty, "General" is used.
            </div>
            <div v-else>
                <b>Opening stock.</b> Columns: <code>Product</code> (product number or exact name) and <code>Quantity</code>. The rows become one <b>Draft positive adjustment</b> for the warehouse you choose, so you can review it and confirm it on the Positive Adjustment page. Stock does not move until you confirm.
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" @@click="handler.template()"><i class="fas fa-download me-1"></i> Download a template</button>
        </div>

        <div class="im-controls">
            <div v-if="state.tab === 'stock'"><label>Warehouse</label>
                <select class="form-select form-select-sm" v-model="state.warehouseId"><option value="">Choose...</option><option v-for="w in state.warehouses" :key="w.id" :value="w.id">{{ w.name }}</option></select></div>
            <div v-if="state.tab === 'stock'"><label>Date</label><input type="date" class="form-control form-control-sm" v-model="state.date"></div>
            <div class="im-file"><label>CSV file</label><input type="file" accept=".csv,text/csv" class="form-control form-control-sm" ref="fileRef" @@change="handler.pick($event)"></div>
        </div>

        <div v-if="state.error" class="alert alert-danger py-2">{{ state.error }}</div>

        <template v-if="state.rows.length">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                <div class="small"><b>{{ state.rows.length }}</b> row(s) read from <b>{{ state.fileName }}</b>.
                    <span v-if="state.result"> Check: <b class="text-success">{{ state.result.created }}</b> ready, <b class="text-warning">{{ state.result.skipped }}</b> skipped, <b class="text-danger">{{ state.result.errors }}</b> with errors.</span></div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-primary me-1" :disabled="state.busy" @@click="handler.run(true)"><i class="fas fa-check-double me-1"></i> Check file</button>
                    <button type="button" class="btn btn-sm btn-primary" :disabled="state.busy || !state.checked || !state.result || !state.result.created" @@click="handler.run(false)"><i class="fas fa-file-import me-1"></i> Import {{ state.result ? state.result.created : 0 }} row(s)</button>
                </div>
            </div>
            <div v-if="state.done" class="alert alert-success py-2">{{ state.done }}</div>
            <div class="table-responsive" style="max-height:420px;overflow:auto">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th style="width:60px">Row</th><th v-for="c in methods.columns()" :key="c">{{ c }}</th><th>Check</th></tr></thead>
                    <tbody>
                        <tr v-for="(r, i) in state.rows.slice(0, 300)" :key="i">
                            <td>{{ i + 2 }}</td>
                            <td v-for="c in methods.columns()" :key="c">{{ r[c] }}</td>
                            <td><span v-if="methods.res(i)" class="badge" :class="methods.badge(methods.res(i).status)">{{ methods.res(i).status }}</span> <small class="text-muted">{{ methods.res(i) ? methods.res(i).message : '' }}</small></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div v-if="state.rows.length > 300" class="small text-muted mt-1">Showing the first 300 rows. All {{ state.rows.length }} are checked and imported.</div>
        </template>
    </div>
</div>

@section scripts {
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .ap-tabs { display: flex; gap: .4rem; }
        .ap-tab { border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 999px; padding: .25rem .9rem; font-size: .8rem; cursor: pointer; }
        .ap-tab.on { background: var(--primary); border-color: var(--primary); color: #fff; }
        .im-help { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: .8rem 1rem; margin-bottom: 1rem; font-size: .88rem; }
        .im-help code { background: var(--line); padding: 0 .3rem; border-radius: 4px; }
        .im-controls { display: grid; grid-template-columns: minmax(200px, 1fr) 170px minmax(240px, 1.5fr); gap: .8rem; margin-bottom: 1rem; }
        .im-controls label { display: block; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .25rem; }
        @@media (max-width: 991px) { .im-controls { grid-template-columns: 1fr; } }
    </style>
    <script src="~/FrontEnd/Pages/Products/ImportData.cshtml.js"></script>
}
