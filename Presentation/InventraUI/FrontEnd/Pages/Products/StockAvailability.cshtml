@page
@attribute [Authorize(Roles = "Products")]
@{
    ViewData["Title"] = "Stock Availability";
}

<div id="app" v-cloak>
    <div class="an-card" style="margin:1rem 1.5rem">
        <div class="an-head">
            <h6><i class="fas fa-layer-group me-2" style="color:var(--primary)"></i>Stock availability <small>on hand, reserved for customers, and on the way</small></h6>
            <button type="button" class="btn btn-sm btn-outline-primary" @@click="handler.load()"><i class="fas fa-sync me-1"></i> Refresh</button>
        </div>

        <div class="sa-kpis">
            <div class="sa-kpi"><span>Products with stock or orders</span><b>{{ state.products }}</b></div>
            <div class="sa-kpi"><span>Reserved for customers</span><b>{{ methods.n(state.totalReserved) }}</b></div>
            <div class="sa-kpi"><span>Incoming from vendors</span><b>{{ methods.n(state.totalIncoming) }}</b></div>
            <div class="sa-kpi" :class="{ bad: state.overcommitted > 0 }"><span>Overcommitted</span><b>{{ state.overcommitted }}</b></div>
            <div class="sa-kpi" :class="{ warn: state.low > 0 }"><span>Low or short</span><b>{{ state.low }}</b></div>
        </div>

        <div class="sa-filters">
            <div class="sa-chips">
                <button v-for="f in state.filters" :key="f.key" type="button" class="sa-chip" :class="{ on: state.filter === f.key }" @@click="state.filter = f.key">{{ f.label }}</button>
            </div>
            <input type="search" class="form-control form-control-sm sa-search" v-model="state.search" placeholder="Search product name or number">
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Product</th><th class="text-end">On hand</th><th class="text-end">Reserved</th><th class="text-end">On hold</th><th class="text-end">Available</th><th class="text-end">Incoming</th><th class="text-end">Projected</th><th>Status</th></tr></thead>
                <tbody>
                    <tr v-if="state.loading"><td colspan="7" class="text-center text-muted py-4">Loading...</td></tr>
                    <tr v-else-if="!methods.rows().length"><td colspan="7" class="text-center text-muted py-4">Nothing matches this filter.</td></tr>
                    <tr v-for="r in methods.rows()" :key="r.productId">
                        <td><div class="fw-semibold">{{ r.name }}</div><small class="text-muted">{{ r.number }}</small></td>
                        <td class="text-end">{{ methods.n(r.onHand) }}</td>
                        <td class="text-end">{{ methods.n(r.reserved) }}</td>
                        <td class="text-end">{{ methods.n(r.held) }}</td>
                        <td class="text-end fw-bold" :class="r.available < 0 ? 'text-danger' : ''">{{ methods.n(r.available) }}</td>
                        <td class="text-end">{{ methods.n(r.incoming) }}</td>
                        <td class="text-end">{{ methods.n(r.projected) }}</td>
                        <td><span class="badge" :class="methods.badge(r.state)">{{ r.state }}</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="small text-muted mt-2">Available = on hand minus quantity promised on confirmed sales orders that has not been delivered yet. Incoming = confirmed purchase orders not yet received.</div>
    </div>
</div>

@section scripts {
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .sa-kpis { display: grid; grid-template-columns: repeat(5, minmax(120px, 1fr)); gap: .8rem; margin-bottom: 1rem; }
        .sa-kpi { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: .7rem .9rem; }
        .sa-kpi span { display: block; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
        .sa-kpi b { font-size: 1.4rem; color: var(--ink); }
        .sa-kpi.bad b { color: var(--bad); } .sa-kpi.warn b { color: var(--warn); }
        .sa-filters { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
        .sa-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
        .sa-chip { border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 999px; padding: .25rem .8rem; font-size: .8rem; cursor: pointer; }
        .sa-chip.on { background: var(--primary); border-color: var(--primary); color: #fff; }
        .sa-search { max-width: 280px; }
        @@media (max-width: 991px) { .sa-kpis { grid-template-columns: 1fr 1fr; } }
    </style>
    <script src="~/FrontEnd/Pages/Products/StockAvailability.cshtml.js"></script>
}
