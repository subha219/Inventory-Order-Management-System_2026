@page
@attribute [Authorize(Roles = "Products")]
@{
    ViewData["Title"] = "Ask Inventory";
}

<div id="app" v-cloak>
    <div class="card">
        <div class="card-header"><h5 class="mb-0"><i class="fas fa-comments me-1"></i> Ask your inventory</h5></div>
        <div class="card-body">
            <form @@submit.prevent="handler.ask(state.question)" class="mb-2">
                <div class="input-group input-group-lg">
                    <input ref="inputRef" v-model="state.question" type="text" class="form-control" autocomplete="off"
                           placeholder="e.g. What is low on stock? / Top selling products this month / stock of Dell Webcams">
                    <button class="btn btn-primary" type="submit" :disabled="state.busy"><i class="fas fa-paper-plane"></i></button>
                </div>
            </form>
            <div class="mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1" v-for="s in state.suggestions" :key="s" @@click="handler.ask(s)">{{ s }}</button>
            </div>

            <div v-if="state.history.length === 0" class="text-muted">
                Ask in plain English. I understand questions about low stock, out of stock, a product's stock, top sellers, slow movers,
                what will run out soon, and inventory value. Answers come straight from your own data.
            </div>

            <div v-for="(h, idx) in state.history" :key="idx" class="mb-3">
                <div class="text-end mb-1"><span class="badge bg-primary fs-6 fw-normal text-wrap text-start">{{ h.question }}</span></div>
                <div class="border rounded p-3 bg-light">
                    <div class="mb-2">{{ h.answer }}</div>
                    <div class="table-responsive" v-if="h.rows.length">
                        <table class="table table-sm table-striped mb-0">
                            <thead><tr><th v-for="c in h.columns" :key="c">{{ c }}</th></tr></thead>
                            <tbody>
                                <tr v-for="(row, i) in h.rows" :key="i"><td v-for="(cell, j) in row" :key="j">{{ cell }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Products/AskInventory.cshtml.js"></script>
}
