@page
@model InventraUI.FrontEnd.Pages.Dashboards.SupervisorDashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Supervisor";
    ViewData["HideHead"] = true;
}

<link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/persona.css" rel="stylesheet" asp-append-version="true" />

<partial name="_PersonaBody" />

@section scripts {
    <script>
        window.PERSONA = {
            title: 'Supervisor',
            subtitle: 'Here is how the floor is running and what is slipping.',
            showUsers: false,
            tiles: [
            { title: 'Tasks & labor', text: 'Assign, chase and close tasks', icon: 'fa-clipboard-check', link: '/Warehouses/Tasks' },
            { title: 'Operations KPIs', text: 'Cycle times, accuracy and dock performance', icon: 'fa-tachometer-alt', link: '/Warehouses/Kpis' },
            { title: 'Pick list', text: 'What to pick, in walking order', icon: 'fa-dolly', link: '/Warehouses/PickList' },
            { title: 'Wave picking', text: 'Batch several orders into one pick', icon: 'fa-layer-group', link: '/Warehouses/WavePicking' },
            { title: 'Packing & shipping', text: 'Pack, label and hand over shipments', icon: 'fa-box-open', link: '/Warehouses/Packing' },
            { title: 'Dock schedule', text: 'Trucks arriving and leaving today', icon: 'fa-truck-loading', link: '/Warehouses/DockSchedule' },
            { title: 'Receiving & put-away', text: 'Book in goods and store them', icon: 'fa-pallet', link: '/Warehouses/PutAway' },
            { title: 'Stock holds', text: 'Quarantine and damaged stock', icon: 'fa-hand-paper', link: '/Warehouses/StockHolds' },
            { title: 'Cycle counts', text: 'Count a few items every day', icon: 'fa-clipboard-list', link: '/StockCounts/CycleCounts' }
            ]
        };
    </script>
    <script src="~/js/persona-dashboard.js" asp-append-version="true"></script>
}
