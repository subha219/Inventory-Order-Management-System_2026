@page
@model InventraUI.FrontEnd.Pages.Dashboards.InventoryDashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Inventory";
    ViewData["HideHead"] = true;
}

<link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/persona.css" rel="stylesheet" asp-append-version="true" />

<partial name="_PersonaBody" />

@section scripts {
    <script>
        window.PERSONA = {
            title: 'Inventory',
            subtitle: 'Here is the stock that needs checking today.',
            showUsers: false,
            tiles: [
            { title: 'Stock availability', text: 'On hand, reserved, held and available', icon: 'fa-boxes', link: '/Products/StockAvailability' },
            { title: 'Batches & expiry', text: 'Lots about to expire', icon: 'fa-hourglass-half', link: '/Products/ProductBatches' },
            { title: 'Cycle counts', text: 'Count a few items every day', icon: 'fa-clipboard-list', link: '/StockCounts/CycleCounts' },
            { title: 'Stock counts', text: 'Full counts and their results', icon: 'fa-tasks', link: '/StockCounts/StockCountList' },
            { title: 'Stock holds', text: 'Quarantine and damaged stock', icon: 'fa-hand-paper', link: '/Warehouses/StockHolds' },
            { title: 'Positive adjustments', text: 'Add stock that was found', icon: 'fa-plus-circle', link: '/PositiveAdjustments/PositiveAdjustmentList' },
            { title: 'Negative adjustments', text: 'Write off missing stock', icon: 'fa-minus-circle', link: '/NegativeAdjustments/NegativeAdjustmentList' },
            { title: 'Costing & landed cost', text: 'What the stock is worth', icon: 'fa-coins', link: '/StockReports/Costing' },
            { title: 'ABC & aging', text: 'Which items matter and which sit still', icon: 'fa-sort-amount-down', link: '/StockReports/Analysis' }
            ]
        };
    </script>
    <script src="~/js/persona-dashboard.js" asp-append-version="true"></script>
}
