@page "/track/{token}"
@model InventraUI.FrontEnd.Pages.Public.TrackModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Track your shipment</title>
    <style>
        :root { --bg: #f4f6fa; --card: #fff; --text: #1b2430; --muted: #6b7686; --line: #e1e6ee; --primary: #2563eb; --ok: #16a34a; }
        @@media (prefers-color-scheme: dark) { :root { --bg: #0f141b; --card: #182029; --text: #e8edf4; --muted: #93a0b2; --line: #2a3441; --primary: #60a5fa; --ok: #4ade80; } }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
        main { max-width: 560px; margin: 0 auto; padding: 24px 16px; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px; margin-bottom: 14px; }
        h1 { font-size: 1.3rem; margin: 0 0 4px; }
        .muted { color: var(--muted); font-size: .9rem; }
        .status { display: inline-block; padding: 4px 12px; border-radius: 99px; font-weight: 600; font-size: .85rem; background: var(--primary); color: #fff; }
        .status.shipped { background: var(--ok); }
        dl { display: grid; grid-template-columns: 130px 1fr; gap: 8px 12px; margin: 16px 0 0; }
        dt { color: var(--muted); } dd { margin: 0; font-weight: 500; word-break: break-word; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        td { padding: 8px 0; border-top: 1px solid var(--line); } td:last-child { text-align: right; }
    </style>
</head>
<body>
<main id="app">
    <div class="card" v-if="loading"><span class="muted">Loading...</span></div>
    <div class="card" v-else-if="!data"><h1>Link not found</h1><p class="muted">This tracking link is not valid. Please check the link you were sent.</p></div>
    <template v-else>
        <div class="card">
            <h1>Shipment {{ data.shipmentNumber }}</h1>
            <div class="muted">Order {{ data.orderNumber }}</div>
            <p><span class="status" :class="{ shipped: data.status === 'Shipped' }">{{ data.status === 'Shipped' ? 'On its way' : 'Being packed' }}</span></p>
            <dl>
                <dt>Carrier</dt><dd>{{ data.carrier || '-' }}</dd>
                <dt>Tracking number</dt><dd>{{ data.trackingNumber || '-' }}</dd>
                <dt>Shipped on</dt><dd>{{ shippedOn }}</dd>
                <dt>Packages</dt><dd>{{ data.packages }}</dd>
            </dl>
        </div>
        <div class="card" v-if="data.items && data.items.length">
            <b>What is in this shipment</b>
            <table><tr v-for="(i, ix) in data.items" :key="ix"><td>{{ i.productName }}</td><td>{{ i.quantity }}</td></tr></table>
        </div>
    </template>
</main>
<script src="~/lib/vue/vue.global.prod.js"></script>
<script>
    var token = '@Model.Token';
    Vue.createApp({
        data: function () { return { loading: true, data: null }; },
        computed: {
            shippedOn: function () { return this.data && this.data.shippedAtUtc ? new Date(this.data.shippedAtUtc).toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' }) : 'Not yet shipped'; }
        },
        mounted: function () {
            var self = this;
            fetch('/api/public/tracking/' + encodeURIComponent(token)).then(function (r) { return r.ok ? r.json() : null; })
                .then(function (j) { self.data = j && j.content ? j.content : null; }).catch(function () { self.data = null; }).finally(function () { self.loading = false; });
        }
    }).mount('#app');
</script>
</body>
</html>
