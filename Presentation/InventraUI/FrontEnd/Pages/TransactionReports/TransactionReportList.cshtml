@page
@attribute [Authorize(Roles = "TransactionReports")]
@{
    ViewData["Title"] = "Transaction Report List";
}

<div id="app" v-cloak>
    <div id="reportKpis" class="rk-kpis"></div>
    <div class="row">
        <div class="col-12">
            <div class="grid-container report-grid">
                <div ref="mainGridRef"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/report-summary.js" asp-append-version="true"></script>
    <script src="~/FrontEnd/Pages/TransactionReports/TransactionReportList.cshtml.js"></script>
}