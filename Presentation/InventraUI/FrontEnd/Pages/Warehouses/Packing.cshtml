@page
@attribute [Authorize(Roles = "Warehouses")]
@{
    ViewData["Title"] = "Packing & Shipping";
}

<div id="app" v-cloak>
    <div class="pk-layout">
        <div class="an-card">
            <div class="an-head"><h6><i class="fas fa-box-open me-2" style="color:var(--primary)"></i>Delivery orders <small>to pack and ship</small></h6></div>
            <input type="search" class="form-control form-control-sm mb-2" v-model="state.search" placeholder="Search number or customer">
            <div v-if="state.loading" class="text-muted small py-3">Loading...</div>
            <div v-else-if="!methods.orders().length" class="text-muted small py-3">No open delivery orders.</div>
            <button v-for="o in methods.orders()" :key="o.id" type="button" class="pk-order" :class="{ on: state.selected === o.id }" @@click="handler.select(o.id)">
                <div class="d-flex justify-content-between"><b>{{ o.number }}</b><span class="badge" :class="methods.badge(o)">{{ methods.label(o) }}</span></div>
                <small class="text-muted">{{ o.customer || 'No customer' }} &middot; {{ methods.day(o.deliveryDate) }}</small>
                <div class="pk-bar"><i :style="{ width: methods.pct(o) + '%' }"></i></div>
            </button>
        </div>

        <div class="an-card">
            <div v-if="!state.selected" class="text-muted py-5 text-center">Choose a delivery order to pack it into cartons and ship it.</div>
            <template v-else>
                <div class="an-head">
                    <h6>{{ state.orderNumber }} <small v-if="state.shipTo">{{ state.shipTo.name }}</small></h6>
                    <button type="button" class="btn btn-sm btn-primary" :disabled="state.saving" @@click="handler.createShipment()"><i class="fas fa-plus me-1"></i> New shipment</button>
                </div>

                <div v-if="state.shipTo" class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-1"></i>{{ methods.address(state.shipTo) }}</div>

                <table class="table table-sm mb-3">
                    <thead><tr><th>Product</th><th class="text-end">Ordered</th><th class="text-end">Packed</th><th class="text-end">Left</th></tr></thead>
                    <tbody>
                        <tr v-for="l in state.lines" :key="l.productId"><td>{{ l.productName }} <small class="text-muted">{{ l.productNumber }}</small></td><td class="text-end">{{ methods.n(l.ordered) }}</td><td class="text-end">{{ methods.n(l.packed) }}</td>
                            <td class="text-end"><b :class="l.ordered - l.packed > 1e-9 ? 'text-warning' : 'text-success'">{{ methods.n(Math.max(l.ordered - l.packed, 0)) }}</b></td></tr>
                    </tbody>
                </table>

                <div v-if="!state.shipments.length" class="text-muted small">No shipment yet. Press "New shipment" to start packing.</div>

                <div v-for="s in state.shipments" :key="s.id" class="pk-line">
                    <div class="d-flex justify-content-between flex-wrap align-items-center">
                        <div><b>{{ s.number }}</b> <span class="badge" :class="s.status === 'Shipped' ? 'bg-success' : 'bg-info text-dark'">{{ s.status }}</span>
                            <small v-if="s.status === 'Shipped'" class="text-muted ms-2">{{ s.carrier }} {{ s.trackingNumber ? '· ' + s.trackingNumber : '' }} &middot; {{ methods.when(s.shippedAtUtc) }}</small></div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" :disabled="!s.packages.length" @@click="handler.slip(s)"><i class="fas fa-print me-1"></i> Packing slip</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" :disabled="!s.packages.length" @@click="handler.labels(s)"><i class="fas fa-tag me-1"></i> Labels</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" :disabled="!s.packages.length" @@click="handler.deliveryNote(s)"><i class="fas fa-file-signature me-1"></i> Delivery note</button>
                            <button v-if="s.status !== 'Shipped'" type="button" class="btn btn-sm btn-outline-danger" @@click="handler.remove(s)"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>

                    <template v-if="s.status === 'Shipped'">
                        <div v-for="p in s.packages" :key="p.id" class="small mt-2"><b>{{ p.packageType }} {{ p.number }}</b> <span class="text-muted">{{ methods.size(p) }}</span>: {{ p.items.map(i => methods.n(i.quantity) + ' x ' + i.productName).join(', ') }}</div>
                        <div class="small text-muted mt-1">Total weight {{ methods.n(s.totalWeightKg) }} kg<span v-if="s.notes"> &middot; {{ s.notes }}</span></div>
                    </template>

                    <template v-else-if="state.edit[s.id]">
                        <div v-for="(p, pi) in state.edit[s.id].packages" :key="pi" class="pk-carton">
                            <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                                <div><label>Carton {{ pi + 1 }}</label>
                                    <select class="form-select form-select-sm" v-model="p.packageType"><option>Carton</option><option>Pallet</option><option>Envelope</option><option>Crate</option></select></div>
                                <div><label>Weight kg</label><input type="number" min="0" step="any" class="form-control form-control-sm" v-model.number="p.weightKg"></div>
                                <div><label>L cm</label><input type="number" min="0" step="any" class="form-control form-control-sm" v-model.number="p.lengthCm"></div>
                                <div><label>W cm</label><input type="number" min="0" step="any" class="form-control form-control-sm" v-model.number="p.widthCm"></div>
                                <div><label>H cm</label><input type="number" min="0" step="any" class="form-control form-control-sm" v-model.number="p.heightCm"></div>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-auto" @@click="handler.removeCarton(s.id, pi)"><i class="fas fa-times"></i></button>
                            </div>
                            <div class="pk-items">
                                <div v-for="l in state.lines" :key="l.productId"><span>{{ l.productName }}</span><input type="number" min="0" step="any" class="form-control form-control-sm text-end" v-model.number="p.qty[l.productId]"></div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" @@click="handler.addCarton(s.id)"><i class="fas fa-plus me-1"></i> Add carton</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @@click="handler.packRest(s.id)">Put everything left into a new carton</button>
                            <button type="button" class="btn btn-sm btn-primary" :disabled="state.saving" @@click="handler.savePackages(s)"><i class="fas fa-save me-1"></i> Save packing</button>
                        </div>
                        <div class="pk-ship mt-3">
                            <div><label>Carrier</label><input class="form-control form-control-sm" v-model="state.edit[s.id].carrier" placeholder="e.g. DHL, Blue Dart"></div>
                            <div><label>Tracking number</label><input class="form-control form-control-sm" v-model="state.edit[s.id].tracking"></div>
                            <div><label>Notes</label><input class="form-control form-control-sm" v-model="state.edit[s.id].notes"></div>
                            <div class="align-self-end"><button type="button" class="btn btn-sm btn-success" :disabled="state.saving || !s.packages.length" @@click="handler.ship(s)"><i class="fas fa-truck me-1"></i> Mark as shipped</button></div>
                        </div>
                        <div v-if="!s.packages.length" class="small text-muted mt-1">Save the packing first, then mark it as shipped.</div>
                    </template>
                </div>
            </template>
        </div>
    </div>
</div>

@section scripts {
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .pk-layout { display: grid; grid-template-columns: minmax(260px, 340px) 1fr; gap: 1rem; margin: 1rem 1.5rem; align-items: start; }
        .pk-order { display: block; width: 100%; text-align: left; border: 1px solid var(--line); background: var(--surface); color: inherit; border-radius: 10px; padding: .6rem .8rem; margin-bottom: .5rem; cursor: pointer; }
        .pk-order.on { border-color: var(--primary); box-shadow: 0 0 0 2px var(--primary-tint); }
        .pk-bar { height: 5px; border-radius: 4px; background: var(--line); margin-top: .4rem; overflow: hidden; }
        .pk-bar i { display: block; height: 100%; background: var(--primary); }
        .pk-line { border: 1px solid var(--line); border-radius: 12px; padding: .8rem 1rem; margin-bottom: .8rem; background: var(--surface-2); }
        .pk-carton { border: 1px dashed var(--line); border-radius: 10px; padding: .7rem; margin-top: .6rem; background: var(--surface); }
        .pk-carton label, .pk-ship label { display: block; font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: .2rem; }
        .pk-carton input, .pk-carton select { width: 100px; }
        .pk-items { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .4rem .9rem; }
        .pk-items > div { display: flex; justify-content: space-between; align-items: center; gap: .5rem; font-size: .85rem; }
        .pk-items input { width: 90px; }
        .pk-ship { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: .6rem; }
        @@media (max-width: 991px) { .pk-layout { grid-template-columns: 1fr; } .pk-ship { grid-template-columns: 1fr; } }
    </style>
    <script src="~/lib/jsbarcode/JsBarcode.all.min.js"></script>
    <script src="~/FrontEnd/Pages/Warehouses/Packing.cshtml.js"></script>
}
