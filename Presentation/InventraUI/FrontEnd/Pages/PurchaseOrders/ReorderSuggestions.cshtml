@page
@attribute [Authorize(Roles = "PurchaseOrders")]
@{
    ViewData["Title"] = "Reorder Suggestions";
}

<div id="app" v-cloak>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
            <h5 class="mb-0"><i class="fas fa-cart-plus me-1"></i> Reorder suggestions</h5>
            <span>
                <button type="button" class="btn btn-outline-secondary btn-sm me-1" @@click="handler.emailNow" :disabled="state.emailing" title="Email the low-stock list to the recipients set in appsettings">
                    <i class="fas fa-envelope me-1"></i> Email alert now
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @@click="handler.reload" :disabled="state.loading">
                    <i class="fas fa-sync me-1"></i> Refresh
                </button>
            </span>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Products at or below their reorder point. Tick the ones to buy, adjust quantities, choose a vendor and tax,
                and a <strong>Draft</strong> purchase order is created for you to review and confirm.
                Set reorder points on the Product page.
            </p>

            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Vendor</label>
                    <select class="form-select" v-model="state.vendorId">
                        <option value="">Select vendor...</option>
                        <option v-for="v in state.vendors" :key="v.id" :value="v.id">{{ v.name }}</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tax</label>
                    <select class="form-select" v-model="state.taxId">
                        <option value="">Select tax...</option>
                        <option v-for="t in state.taxes" :key="t.id" :value="t.id">{{ t.name }}</option>
                    </select>
                </div>
                <div class="col-md-5 d-flex align-items-end">
                    <button type="button" class="btn btn-primary" @@click="handler.createDraft"
                            :disabled="state.saving || selectedCount === 0">
                        <i class="fas fa-file-invoice me-1"></i>
                        Create draft PO ({{ selectedCount }} items, est. {{ methods.money(selectedTotal) }})
                    </button>
                </div>
            </div>

            <div v-if="state.loading" class="text-muted">Loading...</div>
            <div v-else-if="state.items.length === 0" class="alert alert-success mb-0">
                Nothing to reorder. Every product with a reorder point is above it.
            </div>
            <div v-else class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:36px"><input type="checkbox" class="form-check-input" :checked="allSelected" @@change="handler.toggleAll($event.target.checked)"></th>
                            <th>Product</th>
                            <th class="text-end">Stock</th>
                            <th class="text-end">Reorder point</th>
                            <th class="text-end">On draft POs</th>
                            <th class="text-end" style="width:130px">Order qty</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Line total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="r in state.items" :key="r.productId">
                            <td><input type="checkbox" class="form-check-input" v-model="r.selected"></td>
                            <td>{{ r.productName }} <small class="text-muted">{{ r.productNumber }}</small></td>
                            <td class="text-end" :class="r.stock <= 0 ? 'text-danger fw-bold' : ''">{{ methods.num(r.stock) }}</td>
                            <td class="text-end">{{ methods.num(r.reorderPoint) }}</td>
                            <td class="text-end">
                                <span v-if="r.onDraftOrders > 0" class="badge bg-info text-dark">{{ methods.num(r.onDraftOrders) }}</span>
                                <span v-else class="text-muted">-</span>
                            </td>
                            <td class="text-end"><input type="number" min="0" step="any" class="form-control form-control-sm text-end" v-model.number="r.quantity"></td>
                            <td class="text-end">{{ methods.money(r.unitPrice) }}</td>
                            <td class="text-end">{{ methods.money((r.quantity || 0) * r.unitPrice) }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/PurchaseOrders/ReorderSuggestions.cshtml.js"></script>
}
